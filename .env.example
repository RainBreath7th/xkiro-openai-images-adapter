# Required client authentication key. Replace this value before deployment.
API_KEY=change-me-client-key

# Required Xkiro upstream authentication key.
XKIRO_API_KEY=change-me-xkiro-key

# Optional settings.
XKIRO_BASE_URL=https://api.xkiro.com
PORT=5080
UPSTREAM_TIMEOUT_SECONDS=300
STRICT_PARAMETERS=false
MAX_BODY_BYTES=10485760
LOG_LEVEL=INFO
